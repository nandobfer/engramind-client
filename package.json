{
  "name": "@engramind/client",
  "version": "0.12.0",
  "description": "Cliente do Engramind para apps consumidores: servidor (API, proxy, webhook + SSE, contexto, ferramentas e MCP) e componentes React da rede de memórias e da configuração do app.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandobfer/engramind-client.git"
  },
  "homepage": "https://github.com/nandobfer/engramind-client#readme",
  "keywords": [
    "engramind",
    "memory",
    "agents",
    "mcp",
    "react",
    "react-flow"
  ],
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@xyflow/react": "^12.0.0",
    "ai": ">=5.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.14.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.133",
    "framer-motion": "^12.34.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^0.563.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@11.8.0"
}
